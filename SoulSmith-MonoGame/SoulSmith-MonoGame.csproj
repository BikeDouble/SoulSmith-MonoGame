<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Configurations>Debug;Release;Debug Without Building</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.3" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoulSmith.Asset\SoulSmith.Asset.csproj" />
    <ProjectReference Include="..\SoulSmith.Core\SoulSmith.Core.csproj" />
    <ProjectReference Include="..\SoulSmith.Drawing\SoulSmith.Drawing.csproj" />
    <ProjectReference Include="..\SoulSmith.Emotion\SoulSmith.Emotion.csproj" />
    <ProjectReference Include="..\SoulSmith.Game\SoulSmith.Game.csproj" />
    <ProjectReference Include="..\SoulSmith.Input\SoulSmith.Input.csproj" />
    <ProjectReference Include="..\SoulSmith.Object\SoulSmith.Object.csproj" />
    <ProjectReference Include="..\SoulSmith.Polygon\SoulSmith.Shapes.csproj" />
    <ProjectReference Include="..\SoulSmith.Units\SoulSmith.Units.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Emotions\Double\" />
    <Folder Include="Assets\Emotions\Triple\" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>